# Native devices use this host as-is. The web build automatically substitutes
# the current browser hostname while preserving port 3100 and the /api path.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:3100/api

# Used only when live and cached device location are both unavailable.
# Replace these examples with the center point of your supported area.
EXPO_PUBLIC_FALLBACK_LATITUDE=9.99833
EXPO_PUBLIC_FALLBACK_LONGITUDE=122.80834
